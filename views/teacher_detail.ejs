<!Doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title><%= data.name %><%= data.job %>の詳細</title>
    <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  
    <h2><%= data.name %> <%= data.job %></h2>

    <table>
        <tr><th>項目</th><th>データ</th></tr>

        <tr><td>学科</td><td><%= data.department %></td></tr>
        <tr><td>研究室</td><td><%= data.laboratory %></td></tr>
        <tr><td>担当科目</td>
            <td>
                <% if (data.subject == "") { %>
                    なし
                <% } else { %>
                    <%= data.subject %>
                <% } %>
            </td>
        </tr>
    </table>

    <p>
        <a href="/teacher/edit/<%= id %>">編集する</a>
        <br>
        <a href="/teacher">一覧に戻る</a>
        <br><br>
        <a href="/teacher/delete/confirm/<%= id %>" style="color: red;">この教員情報を削除する</a>
    </p>

</body>
</html>