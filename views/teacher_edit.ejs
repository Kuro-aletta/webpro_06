<!Doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title><%= data.name %><%= data.job %>の編集</title>
    <link rel="stylesheet" href="/public/style.css">
</head>
<body>

    <h2><%= data.name %><%= data.job %>の編集</h2>

    <form action="/teacher/edit/confirm/<%= id %>" method="POST">
        <table>
            <tr><th>項目</th><th>データ入力欄</th></tr>
            
            <tr><td>学科</td>
                <td><input type="text" name="department" value="<%= data.department %>"></td>
            </tr>
            <tr><td>氏名</td>
                <td><input type="text" name="name" value="<%= data.name %>"></td>
            </tr>
            <tr><td>職位</td>
                <td><input type="text" name="job" value="<%= data.job %>"></td>
            </tr>
            <tr><td>研究室</td>
                <td><input type="text" name="laboratory" value="<%= data.laboratory %>"></td>
            </tr>
            <tr><td>担当科目</td>
                <td><input type="text" name="subject" value="<%= data.subject %>"></td>
            </tr>
        </table>

        <br><input type="submit" value="確認画面へ">

    </form>

    <p>
        <a href="/teacher/detail/<%= id %>">キャンセル（詳細に戻る）</a>
    </p>

</body>
</html>