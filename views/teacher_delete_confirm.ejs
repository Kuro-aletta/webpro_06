<!Doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>削除の確認</title>
    <link rel="stylesheet" href="/public/style.css">
</head>
<body>

    <h2 class="text-red">本当に削除しますか？</h2>
    <p class="text-blue">以下のデータが完全に消去されます。元に戻すことはできません。</p>

    <table>
        <tr><th>項目</th><th>データ</th></tr>
        <tr><td>学科</td><td><%= data.department %></td></tr>
        <tr><td>氏名</td><td><%= data.name %></td></tr>
        <tr><td>職位</td><td><%= data.job %></td></tr>
        <tr><td>研究室</td><td><%= data.laboratory %></td></tr>
    </table>

    <br>

    <form action="/teacher/delete/<%= id %>" method="POST">
        <input type="submit" value="削除する" class="text-red delete">
    </form>

    <p>
        <a href="/teacher/detail/<%= id %>">キャンセル（詳細に戻る）</a>
    </p>

</body>
</html>