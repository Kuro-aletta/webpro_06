<!Doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>削除の確認</title>
    <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  
    <h2 class="text-red">本当に削除しますか？</h2>
    <p class="text-blue">以下のデータが完全に消去されます。元に戻すことはできません。</p>

    <table>
        <tr><th>項目</th><th>データ</th></tr>
        <tr><td>年度</td><td><%= data.year %></td></tr>
        <tr><td>セメスタ</td><td><%= data.semester %>S</td></tr>
        <tr><td>科目名</td><td><%= data.name %></td></tr>
        <tr><td>担当教員</td><td><%= data.teacher %></td></tr>
        <% if (data.subteacher != "") { %>
            <tr><td>副担当</td><td><%= data.subteacher %></td></tr>
        <% } %>
        <tr><td>単位数</td><td><%= data.credit %></td></tr>
        <tr><td>成績</td><td><%= data.grade %></td></tr>
    </table>

    <br>

    <form action="/result/delete/<%= id %>" method="POST">
        <input type="submit" value="削除する" class="text-red delete" onclick="return confirm('本当に削除しますか？');">
    </form>

    <p>
        <a href="/result/detail/<%= id %>">キャンセル（詳細に戻る）</a>
    </p>

</body>
</html>