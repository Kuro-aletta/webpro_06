<!Doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title><%= data.item %>の編集</title>
    <link rel="stylesheet" href="/public/style.css">
</head>
<body>

    <h2><%= data.item %>の編集</h2>

    <form action="/wallet/edit/confirm/<%= id %>" method="POST">

        <table>
            <tr><th>項目</th><th>データ入力欄</th></tr>
            
            <tr><td>日付</td>
                <td><input type="date" name="date" value="<%= data.date %>"></td>
            </tr>
            <tr><td>項目</td>
                <td><input type="text" name="item" value="<%= data.item %>"></td>
            </tr>
            <tr><td>値段</td>
                <td><input type="number" name="price" value="<%= data.price %>"> 円
                <br><small>※半角数字で入力</small></td>
            </tr>
            <tr><td>購入目的</td>
                <td><input type="text" name="purpose" value="<%= data.purpose %>"></td>
            </tr>
            <tr><td>備考欄</td>
                <td><input type="text" name="memo" value="<%= data.memo %>"></td>
            </tr>
        </table>

        <br><input type="submit" value="確認画面へ">

    </form>

    <p>
        <a href="/wallet/detail/<%= id %>">キャンセル（詳細に戻る）</a>
    </p>

</body>
</html>